
<!-- =============================================
 AVORA SOLUTIONS | ABOUT US
 Complete Elementor HTML Widget
 Open Sans | Navy + Teal | Responsive
 HTML + CSS + Vanilla JS
============================================= -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
#avora-about {
  --navy:#102F46;
  --navy2:#19475A;
  --teal:#168B87;
  --teal-dark:#11746F;
  --mint:#E7F5F2;
  --ice:#F4F9FA;
  --white:#FFFFFF;
  --heading:#15384A;
  --text:#526774;
  --border:#DFE9E9;
  --shadow:0 18px 55px rgba(16,47,70,.08);
  font-family:'Open Sans',sans-serif;
  color:var(--text);
  background:#fff;
  font-size:16px;
  line-height:1.8;
  overflow:hidden;
  isolation:isolate;
}

#avora-about *,
#avora-about *::before,
#avora-about *::after {
  box-sizing:border-box;
}

#avora-about h1,
#avora-about h2,
#avora-about h3,
#avora-about h4,
#avora-about p,
#avora-about ul {
  margin-top:0;
}

#avora-about h1,
#avora-about h2,
#avora-about h3,
#avora-about h4 {
  font-family:'Open Sans',sans-serif;
  color:var(--heading);
  line-height:1.3;
}

#avora-about p,
#avora-about li {
  font-size:16px;
  line-height:1.85;
}

#avora-about a {
  text-decoration:none;
  transition:.25s ease;
}

#avora-about button {
  font-family:inherit;
}

#avora-about button:focus-visible,
#avora-about a:focus-visible {
  outline:3px solid var(--teal);
  outline-offset:4px;
}

#avora-about .av-container {
  width:min(100% - 40px,1200px);
  margin-inline:auto;
}

#avora-about .av-section {
  padding:100px 0;
}

#avora-about .av-kicker {
  display:inline-flex;
  align-items:center;
  gap:10px;
  color:var(--teal);
  font-size:12px;
  font-weight:800;
  letter-spacing:1.8px;
  text-transform:uppercase;
  margin-bottom:16px;
}

#avora-about .av-kicker::before {
  content:"";
  width:22px;
  height:2px;
  background:currentColor;
}

#avora-about .av-heading {
  font-size:clamp(30px,3.5vw,45px);
  letter-spacing:-1.4px;
  font-weight:800;
  margin-bottom:20px;
}

#avora-about .av-heading span {
  color:var(--teal);
}

#avora-about .av-lead {
  max-width:760px;
  font-size:17px;
  line-height:1.85;
}

#avora-about .av-section-head {
  text-align:center;
  max-width:790px;
  margin:0 auto 48px;
}

#avora-about .av-section-head .av-kicker {
  justify-content:center;
}

#avora-about .av-section-head p {
  margin:0 auto;
}

#avora-about .av-btn {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:11px;
  min-height:51px;
  padding:13px 25px;
  background:var(--teal);
  border:1px solid var(--teal);
  border-radius:7px;
  color:#fff;
  font-size:14px;
  font-weight:700;
  line-height:1.5;
}

#avora-about .av-btn:hover {
  background:var(--teal-dark);
  border-color:var(--teal-dark);
  color:#fff;
  transform:translateY(-2px);
}

#avora-about .av-btn-light {
  background:#fff;
  border-color:#fff;
  color:var(--navy);
}

#avora-about .av-btn-light:hover {
  background:var(--mint);
  border-color:var(--mint);
  color:var(--navy);
}

#avora-about .av-btn-outline {
  background:transparent;
  color:var(--navy);
  border-color:#CBDAD9;
}

#avora-about .av-btn-outline:hover {
  background:var(--mint);
  color:var(--navy);
  border-color:var(--teal);
}

#avora-about .av-btn svg {
  width:17px;
  height:17px;
  flex-shrink:0;
}

#avora-about .av-icon {
  width:27px;
  height:27px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

/* =============================================
   01 HERO
============================================= */

#avora-about .av-hero {
  position:relative;
  padding:115px 0 155px;
  background:
    radial-gradient(circle at 80% 25%,rgba(44,158,151,.17),transparent 36%),
    radial-gradient(circle at 10% 90%,rgba(255,255,255,.055),transparent 35%),
    linear-gradient(125deg,#102F46,#19475A);
  overflow:hidden;
}

#avora-about .av-hero::before {
  content:"";
  position:absolute;
  width:620px;
  height:620px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:50%;
  right:-210px;
  top:-230px;
}

#avora-about .av-hero::after {
  content:"";
  position:absolute;
  width:450px;
  height:450px;
  border:1px solid rgba(255,255,255,.07);
  border-radius:50%;
  right:-120px;
  top:-140px;
}

#avora-about .av-hero-grid {
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:70px;
  align-items:center;
}

#avora-about .av-hero .av-kicker {
  color:#87D8D0;
}

#avora-about .av-hero h1 {
  font-size:clamp(40px,4.8vw,64px);
  font-weight:800;
  line-height:1.15;
  letter-spacing:-2.4px;
  color:#fff;
  margin-bottom:25px;
}

#avora-about .av-hero h1 span {
  color:#83D9D0;
}

#avora-about .av-hero p {
  color:#D2E2E8;
  font-size:17px;
  max-width:630px;
  margin-bottom:31px;
}

#avora-about .av-hero-actions {
  display:flex;
  gap:13px;
  flex-wrap:wrap;
}

#avora-about .av-hero-visual {
  position:relative;
  min-height:380px;
  display:grid;
  place-items:center;
}

#avora-about .av-visual-orbit {
  width:min(100%,420px);
  aspect-ratio:1;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.14);
  display:grid;
  place-items:center;
  position:relative;
}

#avora-about .av-visual-orbit::before {
  content:"";
  position:absolute;
  inset:40px;
  border:1px dashed rgba(136,220,211,.25);
  border-radius:50%;
}

#avora-about .av-visual-core {
  width:235px;
  min-height:235px;
  border-radius:28px;
  background:linear-gradient(145deg,rgba(255,255,255,.14),rgba(255,255,255,.035));
  border:1px solid rgba(255,255,255,.2);
  backdrop-filter:blur(8px);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:30px;
  box-shadow:0 25px 80px rgba(0,0,0,.1);
}

#avora-about .av-visual-core svg {
  width:65px;
  height:65px;
  margin-bottom:18px;
  color:#9CE1D9;
  stroke-width:1.3;
}

#avora-about .av-visual-core strong {
  color:#fff;
  font-size:20px;
  line-height:1.35;
}

#avora-about .av-visual-core small {
  color:#C6E1E2;
  font-size:12px;
  margin-top:8px;
}

#avora-about .av-float-pill {
  position:absolute;
  background:#fff;
  border-radius:10px;
  box-shadow:0 15px 40px rgba(0,0,0,.15);
  padding:13px 17px;
  color:var(--heading);
  font-size:13px;
  font-weight:700;
  display:flex;
  align-items:center;
  gap:9px;
}

#avora-about .av-float-pill svg {
  width:19px;
  height:19px;
  color:var(--teal);
}

#avora-about .av-pill-one {
  top:18%;
  left:-8%;
}

#avora-about .av-pill-two {
  bottom:14%;
  right:-5%;
}

/* =============================================
   02 OVERLAP HIGHLIGHTS
============================================= */

#avora-about .av-highlights {
  position:relative;
  z-index:3;
  margin-top:-73px;
}

#avora-about .av-highlights-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

#avora-about .av-highlight-card {
  background:#fff;
  padding:30px 27px;
  border:1px solid var(--border);
  border-radius:12px;
  box-shadow:var(--shadow);
}

#avora-about .av-highlight-icon {
  width:52px;
  height:52px;
  border-radius:11px;
  background:var(--mint);
  color:var(--teal);
  display:grid;
  place-items:center;
  margin-bottom:18px;
}

#avora-about .av-highlight-card h3 {
  font-size:18px;
  font-weight:800;
  margin-bottom:9px;
}

#avora-about .av-highlight-card p {
  margin:0;
  font-size:15px;
}

/* =============================================
   03 ABOUT
============================================= */

#avora-about .av-about-grid {
  display:grid;
  grid-template-columns:.95fr 1.05fr;
  gap:80px;
  align-items:center;
}

#avora-about .av-about-art {
  position:relative;
  min-height:480px;
  border-radius:20px;
  overflow:hidden;
  background:
    radial-gradient(circle at 70% 20%,rgba(255,255,255,.8),transparent 40%),
    linear-gradient(145deg,#E5F3F0,#CDE6E2);
  display:grid;
  place-items:center;
}

#avora-about .av-about-art::before {
  content:"";
  position:absolute;
  width:350px;
  height:350px;
  border:1px solid rgba(22,139,135,.15);
  border-radius:50%;
  top:-150px;
  left:-120px;
}

#avora-about .av-about-art::after {
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  border:1px solid rgba(22,139,135,.14);
  border-radius:50%;
  right:-90px;
  bottom:-100px;
}

#avora-about .av-about-graphic {
  position:relative;
  z-index:1;
  width:72%;
  aspect-ratio:1;
  max-width:320px;
  background:#fff;
  border-radius:28px;
  box-shadow:0 25px 75px rgba(20,83,83,.12);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:35px;
}

#avora-about .av-about-graphic svg {
  width:90px;
  height:90px;
  stroke:var(--teal);
  fill:none;
  stroke-width:1.3;
  margin-bottom:20px;
}

#avora-about .av-about-graphic strong {
  font-size:22px;
  color:var(--navy);
  line-height:1.4;
}

#avora-about .av-about-graphic span {
  font-size:13px;
  margin-top:9px;
}

#avora-about .av-about-copy p {
  margin-bottom:19px;
}

#avora-about .av-check-list {
  list-style:none;
  padding:0;
  margin:24px 0 28px;
}

#avora-about .av-check-list li {
  display:flex;
  gap:12px;
  margin-bottom:12px;
}

#avora-about .av-check-list svg {
  flex-shrink:0;
  width:21px;
  height:21px;
  color:var(--teal);
  margin-top:5px;
}

/* =============================================
   04 MISSION / VALUES
============================================= */

#avora-about .av-mission {
  background:var(--ice);
}

#avora-about .av-values-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

#avora-about .av-value-card {
  padding:34px 30px;
  border:1px solid var(--border);
  border-radius:13px;
  background:#fff;
  transition:transform .25s,box-shadow .25s;
}

#avora-about .av-value-card:hover {
  transform:translateY(-5px);
  box-shadow:var(--shadow);
}

#avora-about .av-value-card .av-highlight-icon {
  margin-bottom:22px;
}

#avora-about .av-value-card h3 {
  font-size:20px;
  margin-bottom:12px;
}

#avora-about .av-value-card p {
  margin:0;
}

/* =============================================
   05 SECURITY
============================================= */

#avora-about .av-security-grid {
  display:grid;
  grid-template-columns:.95fr 1.05fr;
  gap:70px;
  align-items:start;
}

#avora-about .av-security-copy {
  position:sticky;
  top:110px;
}

#avora-about .av-security-copy p {
  margin-bottom:20px;
}

#avora-about .av-security-list {
  display:grid;
  gap:15px;
}

#avora-about .av-security-item {
  display:flex;
  gap:18px;
  padding:25px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
  transition:.25s;
}

#avora-about .av-security-item:hover {
  border-color:#A9D7D0;
  background:#FCFEFD;
  transform:translateX(4px);
}

#avora-about .av-security-item .av-highlight-icon {
  flex-shrink:0;
  margin:0;
}

#avora-about .av-security-item h3 {
  font-size:18px;
  margin-bottom:8px;
}

#avora-about .av-security-item p {
  margin:0;
  font-size:15px;
}

#avora-about .av-security-note {
  background:var(--mint);
  border-left:3px solid var(--teal);
  padding:18px 20px;
  border-radius:0 9px 9px 0;
  margin-top:24px;
  font-size:14px;
}

/* =============================================
   06 WORKFLOWS
============================================= */

#avora-about .av-workflows {
  background:var(--ice);
}

#avora-about .av-workflow-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

#avora-about .av-workflow-card {
  background:#fff;
  border:1px solid var(--border);
  border-radius:13px;
  padding:30px;
  display:flex;
  flex-direction:column;
  min-height:250px;
}

#avora-about .av-workflow-card .av-highlight-icon {
  margin-bottom:19px;
}

#avora-about .av-workflow-card h3 {
  font-size:19px;
  margin-bottom:10px;
}

#avora-about .av-workflow-card p {
  font-size:15px;
  margin-bottom:0;
}

#avora-about .av-workflow-card a {
  color:var(--teal);
  font-size:14px;
  font-weight:800;
  margin-top:auto;
  padding-top:18px;
}

#avora-about .av-workflow-card a:hover {
  color:var(--teal-dark);
}

/* =============================================
   07 PROCESS
============================================= */

#avora-about .av-process-grid {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

#avora-about .av-process-step {
  position:relative;
  padding:26px 22px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
}

#avora-about .av-step-num {
  width:43px;
  height:43px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--mint);
  color:var(--teal);
  font-weight:800;
  font-size:15px;
  margin-bottom:20px;
}

#avora-about .av-process-step h3 {
  font-size:18px;
  margin-bottom:10px;
}

#avora-about .av-process-step p {
  font-size:15px;
  margin:0;
}

/* =============================================
   08 LEADERSHIP
============================================= */

#avora-about .av-leadership {
  background:var(--ice);
}

#avora-about .av-leader {
  display:grid;
  grid-template-columns:390px minmax(0,1fr);
  gap:60px;
  align-items:center;
  background:#fff;
  border:1px solid var(--border);
  border-radius:18px;
  padding:30px;
  margin-bottom:26px;
  box-shadow:0 10px 35px rgba(16,47,70,.035);
}

#avora-about .av-leader.reverse {
  grid-template-columns:minmax(0,1fr) 390px;
}

#avora-about .av-leader.reverse .av-leader-photo {
  order:2;
}

#avora-about .av-leader-photo {
  position:relative;
  width:100%;
  aspect-ratio:4/4.7;
  border-radius:12px;
  background:linear-gradient(145deg,#D7EDE9,#B9DAD5);
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
}

#avora-about .av-leader-photo img {
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  position:relative;
  z-index:2;
}

#avora-about .av-photo-fallback {
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  color:var(--teal-dark);
}

#avora-about .av-photo-fallback svg {
  width:92px;
  height:92px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.1;
}

#avora-about .av-photo-fallback span {
  font-size:12px;
  font-weight:700;
  letter-spacing:.6px;
}

#avora-about .av-leader-role {
  display:inline-block;
  color:var(--teal);
  font-size:12px;
  font-weight:800;
  letter-spacing:1.4px;
  text-transform:uppercase;
  margin-bottom:12px;
}

#avora-about .av-leader h3 {
  font-size:clamp(27px,3vw,36px);
  letter-spacing:-1px;
  margin-bottom:20px;
}

#avora-about .av-leader-content p {
  margin-bottom:17px;
}

#avora-about .av-leader-link {
  display:inline-flex;
  align-items:center;
  gap:10px;
  font-size:14px;
  font-weight:800;
  color:var(--teal);
  margin-top:10px;
}

#avora-about .av-leader-link:hover {
  color:var(--teal-dark);
}

/* =============================================
   09 COMMITMENT
============================================= */

#avora-about .av-commitment {
  position:relative;
  padding:95px 20px;
  background:linear-gradient(135deg,#102F46,#19475A);
  text-align:center;
  overflow:hidden;
}

#avora-about .av-commitment::before {
  content:"";
  position:absolute;
  width:500px;
  height:500px;
  border:1px solid rgba(255,255,255,.08);
  border-radius:50%;
  top:-330px;
  right:-100px;
}

#avora-about .av-commitment-inner {
  position:relative;
  max-width:850px;
  margin:auto;
}

#avora-about .av-commitment .av-kicker {
  color:#93DED6;
}

#avora-about .av-commitment h2 {
  color:#fff;
  font-size:clamp(31px,3.7vw,45px);
  font-weight:800;
  letter-spacing:-1.3px;
  margin-bottom:24px;
}

#avora-about .av-commitment p {
  color:#D7E7EB;
  font-size:17px;
  margin-bottom:18px;
}

/* =============================================
   10 FAQ
============================================= */

#avora-about .av-faq {
  background:#fff;
}

#avora-about .av-faq-inner {
  max-width:900px;
  margin:auto;
}

#avora-about .av-faq-item {
  border:1px solid var(--border);
  border-radius:10px;
  margin-bottom:12px;
  overflow:hidden;
  background:#fff;
}

#avora-about .av-faq-item.open {
  border-color:#ACD6D0;
}

#avora-about .av-faq-question {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  width:100%;
  padding:21px 23px;
  background:#fff;
  border:0;
  text-align:left;
  cursor:pointer;
  color:var(--heading);
  font-size:16px;
  font-weight:700;
  line-height:1.6;
}

#avora-about .av-faq-icon {
  flex-shrink:0;
  width:30px;
  height:30px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--mint);
  color:var(--teal);
  font-size:23px;
  font-weight:400;
  transition:transform .2s;
}

#avora-about .av-faq-item.open .av-faq-icon {
  transform:rotate(45deg);
}

#avora-about .av-faq-answer {
  padding:0 23px 22px;
}

#avora-about .av-faq-answer[hidden] {
  display:none!important;
}

#avora-about .av-faq-answer p {
  margin:0;
}

/* =============================================
   11 FINAL CTA
============================================= */

#avora-about .av-final-cta {
  background:var(--mint);
  padding:85px 0;
}

#avora-about .av-cta-grid {
  display:grid;
  grid-template-columns:1fr auto;
  gap:35px;
  align-items:center;
}

#avora-about .av-final-cta h2 {
  font-size:clamp(29px,3.2vw,41px);
  font-weight:800;
  letter-spacing:-1px;
  margin-bottom:13px;
}

#avora-about .av-final-cta p {
  margin:0;
  max-width:670px;
}

#avora-about .av-cta-actions {
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

/* =============================================
   12 BACK TO TOP
============================================= */

#avora-about .av-back-top {
  position:fixed;
  z-index:999;
  right:25px;
  bottom:25px;
  width:47px;
  height:47px;
  border:0;
  border-radius:50%;
  background:var(--teal);
  color:#fff;
  display:grid;
  place-items:center;
  cursor:pointer;
  box-shadow:0 7px 20px rgba(22,139,135,.28);
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transform:translateY(10px);
  transition:.25s;
}

#avora-about .av-back-top.show {
