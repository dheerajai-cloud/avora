<!-- ==============================
     JAVASCRIPT FUNCTIONALITY
============================== -->
<script>
(function () {
  'use strict';

  function initAvoraPrivacy() {

    const root = document.getElementById('avora-policy');

    if (!root || root.dataset.ready === '1') {
      return;
    }

    root.dataset.ready = '1';

    const links = Array.from(
      root.querySelectorAll('.toc-list a')
    );

    const list = root.querySelector('.toc-list');

    const sections = links
      .map(function (link) {
        return root.querySelector(
          link.getAttribute('href')
        );
      })
      .filter(Boolean);

    const back = root.querySelector('.back-top');

    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let active = '';
    let scheduled = false;

    /* SMOOTH SCROLL PREFERENCE */
    function motion() {
      return reduce.matches ? 'auto' : 'smooth';
    }

    /* ELEMENTOR STICKY HEADER OFFSET */
    function offset() {
      let value = 20;

      const selectors = [
        '.elementor-location-header',
        'header.site-header',
        '#masthead'
      ];

      selectors.forEach(function (selector) {
        const element = document.querySelector(selector);

        if (!element) return;

        const style = window.getComputedStyle(element);
        const rect = element.getBoundingClientRect();

        const sticky =
          style.position === 'sticky' ||
          style.position === 'fixed';

        if (
          sticky &&
          rect.top <= 10 &&
          rect.bottom > 0
        ) {
          value = Math.max(
            value,
            Math.min(rect.bottom, 180) + 14
          );
        }
      });

      return value;
    }

    /* ACTIVE TOC LINK */
    function setActive(id) {

      if (id === active) return;

      active = id;

      links.forEach(function (link) {
        const isActive =
          link.getAttribute('href') === '#' + id;

        link.classList.toggle('active', isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      /* AUTO SCROLL ACTIVE LINK INSIDE SIDEBAR */
      const activeLink = links.find(function (link) {
        return link.getAttribute('href') === '#' + id;
      });

      if (activeLink && list && window.innerWidth > 900) {

        const top =
          activeLink.offsetTop - list.offsetTop;

        const bottom =
          top + activeLink.offsetHeight;

        if (top < list.scrollTop) {
          list.scrollTop = Math.max(0, top - 10);
        } else if (
          bottom > list.scrollTop + list.clientHeight
        ) {
          list.scrollTop =
            bottom - list.clientHeight + 10;
        }
      }
    }

    /* SCROLL TO SELECTED SECTION */
    function go(element) {

      const position =
        element.getBoundingClientRect().top +
        window.scrollY -
        offset() -
        12;

      window.scrollTo({
        top: Math.max(0, position),
        behavior: motion()
      });
    }

    /* TOC CLICK HANDLERS */
    links.forEach(function (link) {

      link.addEventListener('click', function (event) {

        const href = link.getAttribute('href');
        const target = root.querySelector(href);

        if (!target) return;

        event.preventDefault();

        setActive(target.id);
        go(target);

        if (window.history.replaceState) {
          window.history.replaceState(
            null,
            '',
            href
          );
        }
      });
    });

    /* SCROLL POSITION UPDATE */
    function update() {

      const threshold = offset() + 70;

      let current = sections[0];

      sections.forEach(function (section) {

        if (
          section.getBoundingClientRect().top <=
          threshold
        ) {
          current = section;
        }
      });

      /* LAST SECTION AT PAGE BOTTOM */
      if (
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 5
      ) {
        current = sections[sections.length - 1];
      }

      if (current) {
        setActive(current.id);
      }

      /* BACK TO TOP VISIBILITY */
      if (back) {

        const visible = window.scrollY > 500;

        back.classList.toggle('show', visible);
        back.tabIndex = visible ? 0 : -1;
      }
    }

    /* OPTIMIZED SCROLL LISTENER */
    function onScroll() {

      if (scheduled) return;

      scheduled = true;

      window.requestAnimationFrame(function () {
        update();
        scheduled = false;
      });
    }

    window.addEventListener(
      'scroll',
      onScroll,
      { passive: true }
    );

    window.addEventListener(
      'resize',
      onScroll,
      { passive: true }
    );

    /* ACCESSIBLE FAQ ACCORDION */
    const faqItems = Array.from(
      root.querySelectorAll('.faq-item')
    );

    faqItems.forEach(function (item) {

      const button = item.querySelector('.faq-question');
      const panel = item.querySelector('.faq-answer');

      if (!button || !panel) return;

      button.addEventListener('click', function () {

        const wasOpen =
          button.getAttribute('aria-expanded') === 'true';

        /* CLOSE ALL FAQ ITEMS */
        faqItems.forEach(function (other) {

          const otherButton =
            other.querySelector('.faq-question');

          const otherPanel =
            other.querySelector('.faq-answer');

          other.classList.remove('open');

          otherButton.setAttribute(
            'aria-expanded',
            'false'
          );

          otherPanel.hidden = true;
        });

        /* OPEN SELECTED ITEM */
        if (!wasOpen) {

          item.classList.add('open');

          button.setAttribute(
            'aria-expanded',
            'true'
          );

          panel.hidden = false;
        }
      });
    });

    /* BACK TO TOP CLICK */
    if (back) {

      back.addEventListener('click', function () {

        window.scrollTo({
          top: 0,
          behavior: motion()
        });
      });
    }

    /* DYNAMIC COPYRIGHT YEAR */
    const year = root.querySelector('.year');

    if (year) {
      year.textContent = new Date().getFullYear();
    }

    /* INITIALIZE ACTIVE LINK AND BUTTON */
    update();

    /* HANDLE DIRECT SECTION URLS */
    if (window.location.hash.startsWith('#avp-')) {

      const target = root.querySelector(
        window.location.hash
      );

      if (target) {

        window.requestAnimationFrame(function () {
          go(target);
        });
      }
    }
  }

  /* INITIALIZE AFTER DOM LOAD */
  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initAvoraPrivacy,
      { once: true }
    );

  } else {

    initAvoraPrivacy();

  }

})();
</script>
