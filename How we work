
<!-- ==================================================
 AVORA SOLUTIONS — HOW WE WORK
 Elementor HTML Widget | Complete Code
 Brand: Navy #102F46 / Teal #168B87
 Font: Open Sans | Body: 16px
================================================== -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
#av-how {
  --navy:#102F46;
  --navy2:#19475A;
  --teal:#168B87;
  --teal-dark:#0E726E;
  --mint:#E7F5F2;
  --ice:#F4F9FA;
  --white:#fff;
  --heading:#15384A;
  --body:#526774;
  --border:#DFE9E9;
  --shadow:0 18px 50px rgba(16,47,70,.075);
  font-family:'Open Sans',sans-serif;
  font-size:16px;
  line-height:1.8;
  color:var(--body);
  background:#fff;
  overflow:hidden;
  isolation:isolate;
}

#av-how *,
#av-how *::before,
#av-how *::after {
  box-sizing:border-box;
}

#av-how h1,
#av-how h2,
#av-how h3,
#av-how h4,
#av-how p,
#av-how ul {
  margin:0;
}

#av-how h1,
#av-how h2,
#av-how h3,
#av-how h4 {
  font-family:'Open Sans',sans-serif;
  color:var(--heading);
  line-height:1.3;
  font-weight:800;
}

#av-how p,
#av-how li {
  font-size:16px;
  line-height:1.85;
}

#av-how a {
  text-decoration:none;
  transition:.25s ease;
}

#av-how button {
  font-family:inherit;
}

#av-how a:focus-visible,
#av-how button:focus-visible {
  outline:3px solid var(--teal);
  outline-offset:4px;
}

#av-how .avw-container {
  width:min(100% - 40px,1180px);
  margin:auto;
}

#av-how .avw-section {
  padding:90px 0;
}

#av-how .avw-label {
  display:inline-flex;
  align-items:center;
  gap:10px;
  font-size:12px;
  line-height:1.5;
  font-weight:800;
  letter-spacing:1.6px;
  text-transform:uppercase;
  color:var(--teal);
  margin-bottom:15px;
}

#av-how .avw-label::before {
  content:"";
  width:23px;
  height:2px;
  background:currentColor;
}

#av-how .avw-title {
  font-size:clamp(29px,3.4vw,43px);
  letter-spacing:-1.3px;
  margin-bottom:18px;
}

#av-how .avw-title span {
  color:var(--teal);
}

#av-how .avw-section-head {
  text-align:center;
  max-width:750px;
  margin:0 auto 45px;
}

#av-how .avw-section-head .avw-label {
  justify-content:center;
}

#av-how .avw-section-head p {
  max-width:690px;
  margin:auto;
}

#av-how .avw-btn {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:11px;
  padding:14px 25px;
  min-height:52px;
  border:1px solid var(--teal);
  border-radius:7px;
  background:var(--teal);
  color:#fff;
  font-size:14px;
  line-height:1.4;
  font-weight:700;
  cursor:pointer;
}

#av-how .avw-btn:hover {
  background:var(--teal-dark);
  border-color:var(--teal-dark);
  color:#fff;
  transform:translateY(-2px);
}

#av-how .avw-btn-white {
  background:#fff;
  border-color:#fff;
  color:var(--navy);
}

#av-how .avw-btn-white:hover {
  background:var(--mint);
  border-color:var(--mint);
  color:var(--navy);
}

#av-how .avw-btn-outline {
  background:transparent;
  border-color:#BDD4D3;
  color:var(--navy);
}

#av-how .avw-btn-outline:hover {
  background:var(--mint);
  border-color:var(--teal);
  color:var(--navy);
}

#av-how .avw-btn svg {
  width:18px;
  height:18px;
  flex-shrink:0;
}

#av-how .avw-icon {
  width:27px;
  height:27px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

/* ==================================================
 01 HERO
================================================== */

#av-how .avw-hero {
  position:relative;
  padding:105px 0 115px;
  background:
    radial-gradient(circle at 85% 25%,rgba(48,171,160,.18),transparent 34%),
    radial-gradient(circle at 5% 95%,rgba(255,255,255,.055),transparent 30%),
    linear-gradient(125deg,#102F46,#19475A);
}

#av-how .avw-hero::before {
  content:"";
  position:absolute;
  width:520px;
  height:520px;
  border:1px solid rgba(255,255,255,.08);
  border-radius:50%;
  right:-180px;
  top:-260px;
}

#av-how .avw-hero-grid {
  position:relative;
  z-index:1;
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:65px;
  align-items:center;
}

#av-how .avw-hero .avw-label {
  color:#91DDD5;
}

#av-how .avw-hero h1 {
  font-size:clamp(38px,4.7vw,59px);
  letter-spacing:-2px;
  color:#fff;
  line-height:1.16;
  margin-bottom:23px;
}

#av-how .avw-hero h1 span {
  color:#91DDD5;
}

#av-how .avw-hero p {
  color:#D7E6EA;
  font-size:17px;
  max-width:590px;
  margin-bottom:29px;
}

#av-how .avw-hero-actions {
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

#av-how .avw-hero-note {
  display:flex;
  align-items:center;
  gap:9px;
  margin-top:26px;
  color:#B9D9D9;
  font-size:13px;
  font-weight:600;
}

#av-how .avw-hero-note svg {
  width:19px;
  height:19px;
  color:#91DDD5;
}

#av-how .avw-hero-panel {
  background:#fff;
  border:1px solid rgba(255,255,255,.25);
  border-radius:17px;
  padding:28px;
  box-shadow:0 25px 65px rgba(0,0,0,.16);
  transform:rotate(1deg);
}

#av-how .avw-panel-top {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding-bottom:18px;
  border-bottom:1px solid var(--border);
}

#av-how .avw-panel-top strong {
  color:var(--heading);
  font-size:17px;
}

#av-how .avw-panel-tag {
  background:var(--mint);
  color:var(--teal-dark);
  font-size:11px;
  font-weight:800;
  padding:6px 10px;
  border-radius:20px;
  white-space:nowrap;
}

#av-how .avw-panel-list {
  padding-top:19px;
}

#av-how .avw-panel-row {
  display:flex;
  gap:15px;
  position:relative;
  padding-bottom:24px;
}

#av-how .avw-panel-row:last-child {
  padding-bottom:0;
}

#av-how .avw-panel-row:not(:last-child)::after {
  content:"";
  position:absolute;
  left:18px;
  top:39px;
  bottom:0;
  width:1px;
  background:#CFE5E1;
}

#av-how .avw-panel-number {
  flex-shrink:0;
  width:37px;
  height:37px;
  border-radius:50%;
  background:var(--mint);
  color:var(--teal);
  display:grid;
  place-items:center;
  font-size:13px;
  font-weight:800;
}

#av-how .avw-panel-row:last-child .avw-panel-number {
  background:var(--teal);
  color:#fff;
}

#av-how .avw-panel-row strong {
  display:block;
  color:var(--heading);
  font-size:15px;
  margin-bottom:3px;
}

#av-how .avw-panel-row p {
  font-size:13px;
  line-height:1.65;
}

/* ==================================================
 02 FOUR-STEP PROCESS
================================================== */

#av-how .avw-process {
  background:#fff;
}

#av-how .avw-steps {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

#av-how .avw-step {
  position:relative;
  border:1px solid var(--border);
  border-radius:13px;
  background:#fff;
  padding:29px 23px;
  transition:.25s ease;
}

#av-how .avw-step:hover {
  border-color:#A8D5D0;
  box-shadow:var(--shadow);
  transform:translateY(-4px);
}

#av-how .avw-step-number {
  width:48px;
  height:48px;
  display:grid;
  place-items:center;
  border-radius:12px;
  background:var(--mint);
  color:var(--teal);
  font-size:17px;
  font-weight:800;
  margin-bottom:23px;
}

#av-how .avw-step h3 {
  font-size:19px;
  margin-bottom:12px;
}

#av-how .avw-step p {
  font-size:15px;
}

#av-how .avw-step-arrow {
  position:absolute;
  right:-14px;
  top:48px;
  z-index:2;
  width:28px;
  height:28px;
  border:1px solid var(--border);
  border-radius:50%;
  background:#fff;
  color:var(--teal);
  display:grid;
  place-items:center;
  font-size:16px;
}

#av-how .avw-process-foot {
  margin:30px auto 0;
  padding:17px 24px;
  background:var(--mint);
  border-radius:9px;
  max-width:850px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  text-align:center;
}

#av-how .avw-process-foot svg {
  width:22px;
  height:22px;
  color:var(--teal);
  flex-shrink:0;
}

#av-how .avw-process-foot p {
  font-size:15px;
}

#av-how .avw-process-foot strong {
  color:var(--heading);
}

/* ==================================================
 03 PRACTICE SETUP
================================================== */

#av-how .avw-setup {
  background:var(--ice);
}

#av-how .avw-setup-grid {
  display:grid;
  grid-template-columns:.85fr 1.15fr;
  gap:75px;
  align-items:center;
}

#av-how .avw-setup-copy p {
  margin-bottom:18px;
}

#av-how .avw-setup-note {
  padding:18px 20px;
  background:var(--mint);
  border-left:3px solid var(--teal);
  border-radius:0 8px 8px 0;
  font-size:14px;
  margin-top:25px;
}

#av-how .avw-setup-cards {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:17px;
}

#av-how .avw-setup-card {
  background:#fff;
  border:1px solid var(--border);
  border-radius:12px;
  padding:25px 22px;
}

#av-how .avw-setup-card:nth-child(2) {
  transform:translateY(23px);
}

#av-how .avw-setup-card:nth-child(4) {
  transform:translateY(23px);
}

#av-how .avw-setup-icon {
  width:48px;
  height:48px;
  background:var(--mint);
  color:var(--teal);
  border-radius:10px;
  display:grid;
  place-items:center;
  margin-bottom:17px;
}

#av-how .avw-setup-card h3 {
  font-size:17px;
  margin-bottom:9px;
}

#av-how .avw-setup-card p {
  font-size:14px;
}

/* ==================================================
 04 ONBOARDING TIMELINE
================================================== */

#av-how .avw-timeline-section {
  background:#fff;
}

#av-how .avw-timeline-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:65px;
  align-items:center;
}

#av-how .avw-timeline-card {
  border:1px solid var(--border);
  border-radius:16px;
  padding:30px;
  background:#fff;
  box-shadow:var(--shadow);
}

#av-how .avw-time-header {
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:center;
  margin-bottom:27px;
}

#av-how .avw-time-header strong {
  color:var(--heading);
  font-size:18px;
}

#av-how .avw-time-badge {
  background:var(--mint);
  color:var(--teal-dark);
  border-radius:20px;
  padding:7px 13px;
  font-size:12px;
  font-weight:800;
}

#av-how .avw-time-row {
  display:flex;
  gap:17px;
  position:relative;
  padding-bottom:27px;
}

#av-how .avw-time-row:last-child {
  padding-bottom:0;
}

#av-how .avw-time-row:not(:last-child)::before {
  content:"";
  position:absolute;
  left:17px;
  top:36px;
  bottom:0;
  width:2px;
  background:#D5E9E5;
}

#av-how .avw-time-dot {
  flex-shrink:0;
  width:36px;
  height:36px;
  border-radius:50%;
  background:var(--mint);
  display:grid;
  place-items:center;
  color:var(--teal);
  font-weight:800;
  font-size:13px;
}

#av-how .avw-time-row h3 {
  font-size:16px;
  margin:4px 0 7px;
}

#av-how .avw-time-row p {
  font-size:14px;
}

#av-how .avw-time-foot {
  margin-top:24px;
  padding:15px;
  border-radius:9px;
  background:var(--ice);
  text-align:center;
  font-size:13px;
}

#av-how .avw-timeline-copy p {
  margin-bottom:19px;
}

#av-how .avw-check-list {
  list-style:none;
  padding:0;
  margin:22px 0 28px;
}

#av-how .avw-check-list li {
  display:flex;
  align-items:flex-start;
  gap:12px;
  margin-bottom:12px;
}

#av-how .avw-check-list svg {
  flex-shrink:0;
  width:21px;
  height:21px;
  color:var(--teal);
  margin-top:5px;
}

/* ==================================================
 05 AFTER ONBOARDING
================================================== */

#av-how .avw-after {
  background:var(--ice);
}

#av-how .avw-after-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

#av-how .avw-after-card {
  padding:31px 27px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:12px;
}

#av-how .avw-after-icon {
  width:55px;
  height:55px;
  border-radius:12px;
  background:var(--mint);
  color:var(--teal);
  display:grid;
  place-items:center;
  margin-bottom:22px;
}

#av-how .avw-after-card h3 {
  font-size:19px;
  margin-bottom:12px;
}

#av-how .avw-after-card p {
  font-size:15px;
}

#av-how .avw-after-note {
  margin:30px auto 0;
  max-width:900px;
  padding:20px 25px;
  border:1px solid #CDE6E1;
  border-radius:10px;
  background:var(--mint);
  text-align:center;
}

#av-how .avw-after-note p {
  font-size:15px;
}

#av-how .avw-after-note strong {
  color:var(--heading);
}

/* ==================================================
 06 FAQ + CTA
================================================== */

#av-how .avw-faq-section {
  background:#fff;
}

#av-how .avw-faq-grid {
  display:grid;
  grid-template-columns:.7fr 1.3fr;
  gap:65px;
  align-items:start;
}

#av-how .avw-faq-intro p {
  margin-bottom:25px;
}

#av-how .avw-faq-item {
  border:1px solid var(--border);
  border-radius:10px;
  margin-bottom:12px;
  overflow:hidden;
  background:#fff;
}

#av-how .avw-faq-item.open {
  border-color:#A9D8D0;
}

#av-how .avw-faq-question {
  width:100%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:18px;
  padding:20px 22px;
  border:0;
  background:#fff;
  color:var(--heading);
  text-align:left;
  font-size:16px;
  line-height:1.55;
  font-weight:700;
  cursor:pointer;
}

#av-how .avw-faq-plus {
  flex-shrink:0;
  width:29px;
  height:29px;
  border-radius:50%;
  background:var(--mint);
  color:var(--teal);
  display:grid;
  place-items:center;
  font-size:22px;
  font-weight:400;
  transition:transform .2s;
}

#av-how .avw-faq-item.open .avw-faq-plus {
  transform:rotate(45deg);
}

#av-how .avw-faq-answer {
  padding:0 22px 21px;
}

#av-how .avw-faq-answer[hidden] {
  display:none!important;
}

#av-how .avw-faq-answer p {
  font-size:16px;
}

#av-how .avw-cta {
  padding:70px 0;
  background:linear-gradient(125deg,#102F46,#19475A);
}

#av-how .avw-cta-grid {
  display:grid;
  grid-template-columns:1fr auto;
  gap:35px;
  align-items:center;
}

#av-how .avw-cta .avw-label {
  color:#91DDD5;
}

#av-how .avw-cta h2 {
  color:#fff;
  font-size:clamp(29px,3.3vw,40px);
  letter-spacing:-1px;
  margin-bottom:14px;
}

#av-how .avw-cta p {
  color:#D4E6E9;
  max-width:660px;
}

#av-how .avw-cta-actions {
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

/* ==================================================
 BACK TO TOP
================================================== */

#av-how .avw-back-top {
  position:fixed;
  right:24px;
  bottom:24px;
  z-index:999;
  width:46px;
  height:46px;
  border:0;
  border-radius:50%;
  background:var(--teal);
  color:#fff;
  display:grid;
  place-items:center;
  cursor:pointer;
  box-shadow:0 8px 25px rgba(22,139,135,.3);
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transform:translateY(12px);
  transition:.25s;
}

#av-how .avw-back-top.show {
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  transform:translateY(0);
}

#av-how .avw-back-top:hover {
  background:var(--navy);
}

#av-how .avw-back-top svg {
  width:21px;
  height:21px;
  stroke:currentColor;
  stroke-width:2;
  fill:none;
}

/* ==================================================
 RESPONSIVE
================================================== */

@media(max-width:1050px) {
  #av-how .avw-hero-grid {
    gap:35px;
  }

  #av-how .avw-setup-grid,
  #av-how .avw-timeline-grid,
  #av-how .avw-faq-grid {
    gap:40px;
  }

  #av-how .avw-steps {
    grid-template-columns:repeat(2,1fr);
  }

  #av-how .avw-step-arrow {
    display:none;
  }
}

@media(max-width:800px) {
  #av-how .avw-section {
    padding:70px 0;
  }

  #av-how .avw-hero {
    padding:75px 0;
  }

  #av-how .avw-hero-grid,
  #av-how .avw-setup-grid,
  #av-how .avw-timeline-grid,
  #av-how .avw-faq-grid,
  #av-how .avw-cta-grid {
    grid-template-columns:1fr;
  }

  #av-how .avw-hero-panel {
    transform:none;
    max-width:550px;
  }

  #av-how .avw-setup-cards {
    max-width:650px;
  }

  #av-how .avw-cta-actions {
    justify-content:flex-start;
  }
}

@media(max-width:600px) {
  #av-how .avw-container {
    width:min(100% - 34px,1180px);
  }

  #av-how .avw-section {
    padding:58px 0;
  }

  #av-how .avw-hero {
    padding:65px 0;
  }

  #av-how .avw-hero h1 {
    font-size:37px;
    letter-spacing:-1.3px;
  }

  #av-how .avw-hero p {
    font-size:16px;
  }

  #av-how .avw-title {
    font-size:29px;
    letter-spacing:-.8px;
  }

  #av-how .avw-section-head {
    margin-bottom:32px;
  }

  #av-how .avw-hero-actions {
    align-items:stretch;
  }

  #av-how .avw-hero-panel {
    padding:21px;
  }

  #av-how .avw-steps,
  #av-how .avw-setup-cards,
  #av-how .avw-after-grid {
    grid-template-columns:1fr;
  }

  #av-how .avw-setup-card:nth-child(2),
  #av-how .avw-setup-card:nth-child(4) {
    transform:none;
  }

  #av-how .avw-step,
  #av-how .avw-setup-card,
  #av-how .avw-after-card {
    padding:24px;
  }

  #av-how .avw-timeline-card {
    padding:21px;
  }

  #av-how .avw-time-header {
    flex-wrap:wrap;
  }

  #av-how .avw-process-foot {
    align-items:flex-start;
    text-align:left;
  }

  #av-how .avw-faq-question {
    padding:18px;
  }

  #av-how .avw-faq-answer {
    padding:0 18px 19px;
  }

  #av-how .avw-cta {
    padding:60px 0;
  }

  #av-how .avw-cta-actions {
    flex-direction:column;
    align-items:stretch;
  }

  #av-how .avw-back-top {
    right:15px;
    bottom:15px;
  }
}

@media(prefers-reduced-motion:reduce) {
  #av-how *,
  #av-how *::before,
  #av-how *::after {
