<script>
(function () {
  "use strict";

  function initAvoraHowWeWork() {
    const root = document.getElementById("av-how");

    if (!root || root.dataset.avwInit === "true") {
      return;
    }

    root.dataset.avwInit = "true";

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    /* =====================================
       SMOOTH INTERNAL NAVIGATION
    ===================================== */

    root.querySelectorAll('a[href^="#"]').forEach(
      function(link) {
        link.addEventListener("click", function(event) {
          const href = link.getAttribute("href");

          if (!href || href === "#") return;

          const target = root.querySelector(href);

          if (!target) return;

          event.preventDefault();

          const headerOffset = 105;

          const top =
            target.getBoundingClientRect().top +
            window.scrollY -
            headerOffset;

          window.scrollTo({
            top:Math.max(0,top),
            behavior:reducedMotion.matches
              ? "auto"
              : "smooth"
          });
        });
      }
    );

    /* =====================================
       ACCESSIBLE FAQ ACCORDION
       One question open at a time
    ===================================== */

    const faqItems = Array.from(
      root.querySelectorAll(".avw-faq-item")
    );

    faqItems.forEach(function(item) {
      const button = item.querySelector(
        ".avw-faq-question"
      );

      const answer = item.querySelector(
        ".avw-faq-answer"
      );

      if (!button || !answer) return;

      button.addEventListener("click", function() {
        const wasOpen =
          button.getAttribute("aria-expanded") === "true";

        faqItems.forEach(function(otherItem) {
          const otherButton = otherItem.querySelector(
            ".avw-faq-question"
          );

          const otherAnswer = otherItem.querySelector(
            ".avw-faq-answer"
          );

          otherItem.classList.remove("open");

          otherButton.setAttribute(
            "aria-expanded",
            "false"
          );

          otherAnswer.hidden = true;
        });

        if (!wasOpen) {
          item.classList.add("open");

          button.setAttribute(
            "aria-expanded",
            "true"
          );

          answer.hidden = false;
        }
      });
    });

    /* =====================================
       BACK TO TOP
    ===================================== */

    const backTop = root.querySelector(
      ".avw-back-top"
    );

    if (backTop) {
      let ticking = false;

      function updateBackTop() {
        const visible = window.scrollY > 450;

        backTop.classList.toggle(
          "show",
          visible
        );

        backTop.tabIndex = visible ? 0 : -1;
      }

      window.addEventListener(
        "scroll",
        function() {
          if (ticking) return;

          ticking = true;

          window.requestAnimationFrame(function() {
            updateBackTop();
            ticking = false;
          });
        },
        {passive:true}
      );

      backTop.addEventListener(
        "click",
        function() {
          window.scrollTo({
            top:0,
            behavior:reducedMotion.matches
              ? "auto"
              : "smooth"
          });
        }
      );

      updateBackTop();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initAvoraHowWeWork,
      {once:true}
    );
  } else {
    initAvoraHowWeWork();
  }
})();
</script>
