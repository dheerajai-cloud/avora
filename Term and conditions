<script>
(function () {
  'use strict';

  function initAvoraTerms() {

    const root = document.getElementById('avora-terms');

    if (!root || root.dataset.ready === '1') {
      return;
    }

    root.dataset.ready = '1';

    const links = Array.from(
      root.querySelectorAll('.toc-list a')
    );

    const list = root.querySelector('.toc-list');

    const sections = links
      .map(function (link) {
        return root.querySelector(
          link.getAttribute('href')
        );
      })
      .filter(Boolean);

    const backTop = root.querySelector('.back-top');

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let activeId = '';
    let ticking = false;

    /* ------------------------------------
       SMOOTH SCROLL
    ------------------------------------ */

    function getScrollBehavior() {
      return reducedMotion.matches
        ? 'auto'
        : 'smooth';
    }

    /* ------------------------------------
       ELEMENTOR HEADER OFFSET
    ------------------------------------ */

    function getHeaderOffset() {

      let offset = 20;

      const selectors = [
        '.elementor-location-header',
        'header.site-header',
        '#masthead'
      ];

      selectors.forEach(function (selector) {

        const element = document.querySelector(selector);

        if (!element) return;

        const style = window.getComputedStyle(element);
        const rect = element.getBoundingClientRect();

        const isSticky =
          style.position === 'sticky' ||
          style.position === 'fixed';

        if (
          isSticky &&
          rect.top <= 10 &&
          rect.bottom > 0
        ) {
          offset = Math.max(
            offset,
            Math.min(rect.bottom, 180) + 14
          );
        }
      });

      return offset;
    }

    /* ------------------------------------
       SET ACTIVE SIDEBAR LINK
    ------------------------------------ */

    function setActive(id) {

      if (id === activeId) return;

      activeId = id;

      links.forEach(function (link) {

        const isActive =
          link.getAttribute('href') === '#' + id;

        link.classList.toggle('active', isActive);

        if (isActive) {
          link.setAttribute(
            'aria-current',
            'location'
          );
        } else {
          link.removeAttribute('aria-current');
        }
      });

      /* Keep active link visible
         inside scrollable sidebar */

      const activeLink = links.find(function (link) {
        return link.getAttribute('href') === '#' + id;
      });

      if (
        activeLink &&
        list &&
        window.innerWidth > 900
      ) {

        const top =
          activeLink.offsetTop - list.offsetTop;

        const bottom =
          top + activeLink.offsetHeight;

        if (top < list.scrollTop) {

          list.scrollTop = Math.max(0, top - 10);

        } else if (
          bottom > list.scrollTop + list.clientHeight
        ) {

          list.scrollTop =
            bottom - list.clientHeight + 10;
        }
      }
    }

    /* ------------------------------------
       SCROLL TO SECTION
    ------------------------------------ */

    function scrollToSection(target) {

      const position =
        target.getBoundingClientRect().top +
        window.scrollY -
        getHeaderOffset() -
        12;

      window.scrollTo({
        top: Math.max(0, position),
        behavior: getScrollBehavior()
      });
    }

    /* ------------------------------------
       TOC LINK CLICK
    ------------------------------------ */

    links.forEach(function (link) {

      link.addEventListener('click', function (event) {

        const href = link.getAttribute('href');
        const target = root.querySelector(href);

        if (!target) return;

        event.preventDefault();

        setActive(target.id);

        scrollToSection(target);

        if (window.history.replaceState) {
          window.history.replaceState(
            null,
            '',
            href
          );
        }
      });
    });

    /* ------------------------------------
       UPDATE ACTIVE LINK ON SCROLL
    ------------------------------------ */

    function updateOnScroll() {

      const threshold = getHeaderOffset() + 70;

      let current = sections[0];

      sections.forEach(function (section) {

        if (
          section.getBoundingClientRect().top <=
          threshold
        ) {
          current = section;
        }
      });

      /* Detect bottom of page */

      if (
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 5
      ) {
        current = sections[sections.length - 1];
      }

      if (current) {
        setActive(current.id);
      }

      /* Show back to top after 500px */

      if (backTop) {

        const visible = window.scrollY > 500;

        backTop.classList.toggle(
          'show',
          visible
        );

        backTop.tabIndex = visible ? 0 : -1;
      }
    }

    /* ------------------------------------
       OPTIMIZED SCROLL EVENT
    ------------------------------------ */

    function handleScroll() {

      if (ticking) return;

      ticking = true;

      window.requestAnimationFrame(function () {

        updateOnScroll();

        ticking = false;
      });
    }

    window.addEventListener(
      'scroll',
      handleScroll,
      { passive: true }
    );

    window.addEventListener(
      'resize',
      handleScroll,
      { passive: true }
    );

    /* ------------------------------------
       ACCESSIBLE FAQ ACCORDION
    ------------------------------------ */

    const faqItems = Array.from(
      root.querySelectorAll('.faq-item')
    );

    faqItems.forEach(function (item) {

      const button = item.querySelector('.faq-question');
      const panel = item.querySelector('.faq-answer');

      if (!button || !panel) return;

      button.addEventListener('click', function () {

        const wasOpen =
          button.getAttribute('aria-expanded') === 'true';

        /* Close all items */

        faqItems.forEach(function (other) {

          const otherButton =
            other.querySelector('.faq-question');

          const otherPanel =
            other.querySelector('.faq-answer');

          other.classList.remove('open');

          otherButton.setAttribute(
            'aria-expanded',
            'false'
          );

          otherPanel.hidden = true;
        });

        /* Open clicked item */

        if (!wasOpen) {

          item.classList.add('open');

          button.setAttribute(
            'aria-expanded',
            'true'
          );

          panel.hidden = false;
        }
      });
    });

    /* ------------------------------------
       BACK TO TOP
    ------------------------------------ */

    if (backTop) {

      backTop.addEventListener('click', function () {

        window.scrollTo({
          top: 0,
          behavior: getScrollBehavior()
        });
      });
    }

    /* ------------------------------------
       COPYRIGHT YEAR
    ------------------------------------ */

    const year = root.querySelector('.year');

    if (year) {
      year.textContent = new Date().getFullYear();
    }

    /* ------------------------------------
       INITIAL STATE
    ------------------------------------ */

    updateOnScroll();

    /* Direct URL anchor support */

    if (window.location.hash.startsWith('#avt-')) {

      const target = root.querySelector(
        window.location.hash
      );

      if (target) {

        window.requestAnimationFrame(function () {
          scrollToSection(target);
        });
      }
    }
  }

  /* ------------------------------------
     DOM READY
  ------------------------------------ */

  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initAvoraTerms,
      { once: true }
    );

  } else {

    initAvoraTerms();

  }

})();
</script>
